# Quattlebaum Music — environment
#
# Copy to .env.local for development. .env.local is gitignored and must never
# be committed. Only variables prefixed NEXT_PUBLIC_ are exposed to the browser;
# everything else stays on the server.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap, and payment redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Which provider implementation to load: see src/lib/payments/index.ts.
# "mock" is development only and refuses to start in production.
PAYMENT_PROVIDER=mock

# SERVER ONLY. The provider's secret API key. Never prefix this NEXT_PUBLIC_,
# never log it, never send it to the browser.
PAYMENT_SECRET_KEY=

# SERVER ONLY. Used to cryptographically verify incoming webhooks. Without
# this, anything could POST "this order is paid" at the webhook endpoint.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Safe to expose. The publishable key the provider's browser SDK uses.
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Enquiry delivery (not yet wired up — see PENDING.md)
# ---------------------------------------------------------------------------
# SERVER ONLY. API key for whichever transactional mail provider is chosen.
# MAIL_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — Make an Offer (see PENDING.md §4c)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose (sb_publishable_...). Used for the staff magic link and for
# staff reads, which RLS limits to the offer_staff list.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY (sb_secret_...). Read only in src/lib/server/supabase.ts. Never
# prefix NEXT_PUBLIC_, never log it, never commit it.
SUPABASE_SECRET_KEY=
